# VeraDroid slim: settings shared by the slim product variants (veradroid_kindle_slim, veradroid_kindle32_slim).
# Include this BEFORE inheriting the normal product: the build uses the FIRST system/etc/preloaded-classes entry of
# PRODUCT_COPY_FILES both as the file that is installed and as the boot image's --image-classes
# (build/core/dex_preopt_libart.mk), so ours has to come before the one core_minimal.mk adds.
# What each item is for, and what it saves: docs/slim-android.md.

# zygote preload list / boot image classes without telephony, bluetooth, nfc, camera, media, print, speech, opengl ...
# (generated by android/gen-slim-preloaded-classes.py)
PRODUCT_COPY_FILES := \
    device/veradroid/kindle/slim/preloaded-classes:system/etc/preloaded-classes \
    device/veradroid/kindle/slim/handheld_core_hardware.xml:system/etc/permissions/handheld_core_hardware.xml \
    device/veradroid/kindle/slim/init.kindle.slim.rc:root/init.kindle.slim.rc

# system_server services with a switch in SystemServer.java (7.1.1) that a reader never uses, and no EGL preload in zygote.
# The host scripts (boot/lib/slim.sh) add the same to an image that was built without them and see ro.vd.slim to skip that.
PRODUCT_PROPERTY_OVERRIDES += \
    ro.vd.slim=1 \
    ro.zygote.disable_gl_preload=true \
    config.disable_rtt=true \
    config.disable_mediaproj=true \
    config.disable_serial=true \
    config.disable_samplingprof=true \
    config.disable_networktime=true \
    config.disable_otadexopt=true \
    persist.sys.strictmode.disable=true
# persist.sys.strictmode.disable: userdebug images turn StrictMode's thread policy on for system apps (VeraHome): every
# disk read / write on a main thread was reported through binder to ActivityManager and written to dropbox (PW2: launcher
# ANRs). It only switches off that debug reporting; the file:// VM policy of targetSdk 24+ apps is not affected.
