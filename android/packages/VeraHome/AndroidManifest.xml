<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.veradroid.home"
    android:versionCode="138"
    android:versionName="1.49">
    <uses-sdk android:minSdkVersion="25" android:targetSdkVersion="25" />
    <uses-permission android:name="android.permission.MANAGE_ACTIVITY_STACKS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.CLEAR_APP_USER_DATA" />
    <uses-permission android:name="android.permission.CLEAR_APP_CACHE" />
    <!-- 管理网页“清除缓存”（单个应用）：PackageManager.deleteApplicationCacheFiles 要它，平台签名的特权应用可以拿到 -->
    <uses-permission android:name="android.permission.DELETE_CACHE_FILES" />
    <uses-permission android:name="android.permission.FORCE_STOP_PACKAGES" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.KILL_UID" />
    <uses-permission android:name="android.permission.SET_ACTIVITY_WATCHER" />
    <uses-permission android:name="android.permission.GET_PACKAGE_SIZE" />
    <uses-permission android:name="android.permission.GET_TASKS" />
    <uses-permission android:name="android.permission.REAL_GET_TASKS" />
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <uses-permission android:name="android.permission.REMOVE_TASKS" />
    <uses-permission android:name="android.permission.INJECT_EVENTS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 状态栏的占位窗口（TYPE_STATUS_BAR）和三大金刚键（TYPE_NAVIGATION_BAR）：系统按真的系统栏给应用让位（WindowManager 要 INTERNAL_SYSTEM_WINDOW，策略要 STATUS_BAR_SERVICE；平台签名才给） -->
    <uses-permission android:name="android.permission.STATUS_BAR_SERVICE" />
    <uses-permission android:name="android.permission.INTERNAL_SYSTEM_WINDOW" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- gid media_rw: /data/media/0 is 0770 media_rw until after_boot opens it up, but VeraHome starts first and
         keeps its settings in /data/media/0/.vdhome (see Store.java) -->
    <uses-permission android:name="android.permission.WRITE_MEDIA_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- 方块风格首页的 Android 小部件卡片（AppWidgetHost）：平台签名的特权应用可以直接绑定 -->
    <uses-permission android:name="android.permission.BIND_APPWIDGET" />
    <application
        android:name=".VeraApp"
        android:label="VeraDroid"
        android:allowBackup="false"
        android:persistent="true"
        android:directBootAware="true"
        android:hardwareAccelerated="false"
        android:theme="@android:style/Theme.Holo.Light.NoActionBar">
        <activity
            android:name=".HomeActivity"
            android:directBootAware="true"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:screenOrientation="nosensor"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- 盖在当前应用上面的设置（下拉面板 / 宿主的“设置”）：自己的任务，返回 / ✕ 回到原来的应用 -->
        <activity
            android:name=".SettingsActivity"
            android:taskAffinity="com.veradroid.home.settings"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:screenOrientation="nosensor"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale" />
        <activity
            android:name=".PanelActivity"
            android:theme="@android:style/Theme.Holo.Light.Dialog.NoActionBar"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity="com.veradroid.home.panel"
            android:screenOrientation="nosensor"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale" />
        <activity
            android:name=".InboxActivity"
            android:theme="@android:style/Theme.Holo.Light.NoActionBar"
            android:excludeFromRecents="true"
            android:screenOrientation="nosensor"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale" />
        <activity
            android:name=".StatsActivity"
            android:theme="@android:style/Theme.Holo.Light.NoActionBar"
            android:excludeFromRecents="true"
            android:screenOrientation="nosensor"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale" />
        <activity
            android:name=".StorageActivity"
            android:theme="@android:style/Theme.Holo.Light.NoActionBar"
            android:excludeFromRecents="true"
            android:screenOrientation="nosensor"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale" />
        <activity
            android:name=".BackupActivity"
            android:theme="@android:style/Theme.Holo.Light.NoActionBar"
            android:excludeFromRecents="true"
            android:screenOrientation="nosensor"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale" />
        <activity
            android:name=".StoreActivity"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.Holo.Light.NoActionBar"
            android:excludeFromRecents="true"
            android:screenOrientation="nosensor"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale" />
        <activity
            android:name=".FontStoreActivity"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.Holo.Light.NoActionBar"
            android:excludeFromRecents="true"
            android:screenOrientation="nosensor"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale" />
        <activity
            android:name=".FilePickerActivity"
            android:theme="@android:style/Theme.Holo.Light.NoActionBar"
            android:screenOrientation="nosensor"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.GET_CONTENT" />
                <action android:name="android.intent.action.OPEN_DOCUMENT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <provider
            android:name=".VeraFileProvider"
            android:authorities="com.veradroid.home.files"
            android:exported="false"
            android:grantUriPermissions="true" />
        <activity
            android:name=".AppDisplayActivity"
            android:theme="@android:style/Theme.Holo.Light.NoActionBar"
            android:screenOrientation="nosensor"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale" />
        <!-- 系统里没有“设置”应用：应用在没网时打开系统的 Wi-Fi 设置（Settings.ACTION_WIFI_SETTINGS 等）会因为
             ActivityNotFoundException 直接闪退（用户诊断：多看 com.duokan.reader 书架的“去联网”）。由这一页接住。 -->
        <activity
            android:name=".WifiActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Holo.Light.NoActionBar"
            android:screenOrientation="nosensor"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale">
            <intent-filter>
                <action android:name="android.settings.WIFI_SETTINGS" />
                <action android:name="android.settings.WIFI_IP_SETTINGS" />
                <action android:name="android.settings.WIRELESS_SETTINGS" />
                <action android:name="android.net.wifi.PICK_WIFI_NETWORK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- 安装程序“禁止安装来源不明的应用”对话框的“设置”按钮（SECURITY_SETTINGS），以及 Android 8 应用发的
             MANAGE_UNKNOWN_APP_SOURCES：系统里没有“设置”应用，没人接就是点了没反应 / ActivityNotFoundException 闪退。
             打开“未知来源”、提示一句就关掉（UnknownSourcesActivity）。 -->
        <activity
            android:name=".UnknownSourcesActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale">
            <intent-filter>
                <action android:name="android.settings.SECURITY_SETTINGS" />
                <action android:name="android.settings.MANAGE_UNKNOWN_APP_SOURCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.settings.MANAGE_UNKNOWN_APP_SOURCES" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="package" />
            </intent-filter>
        </activity>
        <!-- 第三方输入法（讯飞、搜狗、同文、微信等）引导页“启用输入法”发的 INPUT_METHOD_SETTINGS：系统里没有“设置”应用，由这一页接住。 -->
        <activity
            android:name=".ImeSettingsActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale">
            <intent-filter>
                <action android:name="android.settings.INPUT_METHOD_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".BluetoothActivity"
            android:theme="@android:style/Theme.Holo.Light.NoActionBar"
            android:screenOrientation="nosensor"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale" />
        <activity
            android:name=".TransferActivity"
            android:theme="@android:style/Theme.Holo.Light.NoActionBar"
            android:excludeFromRecents="true"
            android:screenOrientation="nosensor"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale" />
        <activity
            android:name=".BookshelfActivity"
            android:theme="@android:style/Theme.Holo.Light.NoActionBar"
            android:windowSoftInputMode="stateAlwaysHidden|adjustPan"
            android:excludeFromRecents="true"
            android:screenOrientation="nosensor"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale" />
        <activity
            android:name=".TouchTestActivity"
            android:theme="@android:style/Theme.Holo.Light.NoActionBar"
            android:excludeFromRecents="true"
            android:screenOrientation="nosensor"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale" />
        <activity
            android:name=".ReaderActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:screenOrientation="nosensor"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale" />
        <activity
            android:name=".SwitcherActivity"
            android:theme="@android:style/Theme.Holo.Light.Dialog.NoActionBar"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity="com.veradroid.home.switcher"
            android:screenOrientation="nosensor"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale" />
        <!-- feat/parity-gaps：显示与刷新 / 系统与性能、锁屏密码、屏保挑选；同时兜底 android.settings.SETTINGS 等常见系统设置意图（修复用户诊断 中 Legado 跳系统设置闪退） -->
        <activity
            android:name=".HostSettingsActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Holo.Light.NoActionBar"
            android:excludeFromRecents="true"
            android:screenOrientation="nosensor"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale">
            <intent-filter>
                <action android:name="android.settings.SETTINGS" />
                <action android:name="android.settings.DISPLAY_SETTINGS" />
                <action android:name="android.settings.APPLICATION_SETTINGS" />
                <action android:name="android.settings.MANAGE_APPLICATIONS_SETTINGS" />
                <action android:name="android.settings.DATE_SETTINGS" />
                <action android:name="android.settings.LOCALE_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".LockSettingsActivity"
            android:theme="@android:style/Theme.Holo.Light.NoActionBar"
            android:excludeFromRecents="true"
            android:screenOrientation="nosensor"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale" />
        <activity
            android:name=".ScreensaverActivity"
            android:theme="@android:style/Theme.Holo.Light.NoActionBar"
            android:excludeFromRecents="true"
            android:screenOrientation="nosensor"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale" />
        <service android:name=".HostService" android:exported="false" />
        <service android:name=".StatusBarService" android:exported="false" />
        <service android:name=".NavBarService" android:exported="false" />
        <service
            android:name=".NotifService"
            android:label="VeraDroid"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
